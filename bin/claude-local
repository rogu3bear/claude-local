#!/usr/bin/env bash
# claude-local: launch Claude Code exclusively against a local model server,
# using a fully isolated config directory so your normal ~/.claude setup is
# never read or written.
#
# Flow: check server -> pick a model (with load state) -> load it (timed) ->
# start a usage proxy -> start claude pointed at it, with prefix-cache-friendly
# flags and an autocompact window matched to the server's real context ->
# after close, offer to unload / leave / load a different model.
#
# Env overrides:
#   CLAUDE_LOCAL_MODEL        model name to use directly, skipping the menu
#   CLAUDE_LOCAL_PORT         server port (default 1234)
#   CLAUDE_LOCAL_CONFIG       isolated config dir (default ~/.claude-local)
#   CLAUDE_LOCAL_BACKEND      backend adapter name: ollama (default) | llamaserver
#                             (the env file maps each backend to its port: 1234 / 1244)
#   CLAUDE_LOCAL_PROXY        1 = route through the usage proxy (default 1), 0 = direct
#   CLAUDE_LOCAL_PROXY_PORT   first proxy port to try (default PORT+1; next free one is used)
#   CLAUDE_LOCAL_MAX_OUTPUT   max output tokens per turn (default 16384 since 2026-09-08, was 8192;
#                             Claude's own default is 32000). A truncated Write of a large file fails
#                             the turn; the extra 8K comes out of the autocompact budget (112640 at 128K).
#   CLAUDE_LOCAL_AUTOCOMPACT  autocompact window in tokens
#                             (default: server context - max output - 2048, floor 100000)
#   CLAUDE_LOCAL_OFFLINE      1 = block all non-localhost network from Claude via a dead
#                             HTTPS_PROXY; 0 = allow internet (default 0 since 2026-09-07 so that
#                             WebFetch and the web search below work; was 1)
#   CLAUDE_LOCAL_WEBSEARCH    1 = register config/mcp-websearch.py as an MCP server (default 1;
#                             forced off when offline). Claude Code's built-in WebSearch is run by
#                             Anthropic's API, so against a local server it returns nothing; the
#                             MCP tool mcp__websearch__web_search (DuckDuckGo) replaces it.
#   CLAUDE_LOCAL_PROMPT       append | replace | none  (default append)
#                             append  = built-in prompt + system_prompt.md
#                             replace = system_prompt_compact.md instead of the built-in prompt
#   CLAUDE_LOCAL_SNAPSHOT     1 = --system-prompt-snapshot on + exclude dynamic sections (default 1)
#   CLAUDE_LOCAL_TOOLS        comma list passed as --tools: the ONLY built-in tools the model sees
#                             (MCP tools are added on top). Default since 2026-09-07: the core six
#                             plus Agent, WebFetch, the todo/task tools, ProposeGoal and
#                             ReportFindings (see TOOLS below), chosen for capability over speed.
#                             Measured 2026-09-05: with the full tool list a small local model
#                             burns ~30% of its turns on meta-tools and the schemas cost ~5K
#                             prompt tokens; the benchmark keeps the core six. WebSearch is left
#                             out on purpose (see CLAUDE_LOCAL_WEBSEARCH). Set to "" for the full list.
#   CLAUDE_LOCAL_DISALLOWED_TOOLS  extra comma list passed as --disallowedTools (default none)
#   CLAUDE_LOCAL_PERMISSION_MODE  passed as --permission-mode unless the command line already carries
#                             one (or --dangerously-skip-permissions): acceptEdits (default) | manual |
#                             plan | dontAsk | bypassPermissions. Not auto: settings.json sets
#                             permissions.disableAutoMode, so Claude Code ignores --permission-mode auto
#                             and hides the mode from Shift+Tab (verified 2026-09-09); auto mode's classifier sends a ~35K-token prompt to
#                             a hosted model for every tool call it evaluates, which here is an HTTP 400
#                             from the router and then the same prompt on the single local slot
#                             (seen 2026-09-08). The deterministic guard in hook-audit.py is the gate
#                             instead, in every mode (make check-guard proves it) (Claude Code 2.1.266).
#   Model aliases             every internal model choice is pinned to the session model unless the
#                             variable is already set, six variables: ANTHROPIC_DEFAULT_{OPUS,SONNET,HAIKU}_MODEL,
#                             CLAUDE_CODE_AUTO_MODE_MODEL, CLAUDE_CODE_BG_CLASSIFIER_MODEL,
#                             CLAUDE_CONTEXT_COLLAPSE_MODEL. A subagent asked for "haiku" or a classifier
#                             then never reaches the router with a name it does not know.
#                             CLAUDE_CODE_SUBAGENT_MODEL is left unset on purpose: Claude Code gives a
#                             subagent the parent's current model unless it is set, so subagents follow
#                             a mid-session /model switch. Any claude-* name that still reaches the proxy
#                             is rewritten to the session's current model (model_rewritten event).
#   CLAUDE_LOCAL_SAMPLING     JSON sampling override applied by the proxy to every request,
#                             e.g. '{"temperature":0.7,"top_p":0.8,"top_k":20}' (default: none)
#   CLAUDE_LOCAL_CHECKPOINT   seconds of idleness after a turn before the proxy saves the model's
#                             prompt cache to ~/.claude-local/slots (default 20; 0 = off; llama-server
#                             only). The proxy also reloads a preset that died and restores that
#                             checkpoint before the next turn, and saves once more at exit, so a
#                             server crash costs one turn and the retry starts warm.
#   CLAUDE_LOCAL_IDLE_UNLOAD  seconds a resident preset may go unused by every session before the
#                             proxy checkpoints and unloads it (default 1200; 0 = off; llama-server
#                             only; never the session's own model). Last use is shared through
#                             run/last_use.json, so concurrent sessions do not evict each other's model.
#   CLAUDE_LOCAL_EXCLUSIVE    1 = at start, evict whatever the *other* backend has loaded (Ollama
#                             models via keep_alive 0; llama-server presets after a checkpoint) so
#                             two servers never share the GPU pool (default 1); 0 = leave them
#   CLAUDE_LOCAL_URLGUARD     1 = the PreToolUse hook config/hook-urlguard.py denies WebFetch on a
#                             URL that never appeared in a user message, search result or tool
#                             output (default 1); 0 = fetch anything
#   CLAUDE_LOCAL_PROXY_DEBUG  1 = proxy also logs request params/tool count/system size;
#                             2 = also dump every request body to run/<pid>/requests/
#   CLAUDE_LOCAL_CLAUDE_DEBUG 1 = Claude Code writes its own debug log (API attempts, MCP, hooks) to
#                             run/<pid>/claude-debug.log via --debug-file (default 1; the TUI is unchanged)
#   CLAUDE_LOCAL_LOG_DIR      where the structured event log and session archives go
#                             (default ~/.claude-local/logs: events.jsonl, sessions/<start>-<pid>/)
#   CLAUDE_LOCAL_BASHGUARD    1 = config/hook-audit.py refuses Bash commands that would destroy the tree
#   CLAUDE_LOCAL_PATHGUARD        or kill the server/proxy serving this session, and Write/Edit to
#                             mangled or system paths (default 1 each; 0 = off). Every tool call is
#                             logged to run/<pid>/tools.jsonl regardless (CLAUDE_LOCAL_AUDIT=0 stops that).
#
# Errors and diagnostics: every failure the launcher, proxy or hooks see is one line in
# run/<pid>/events.jsonl and ~/.claude-local/logs/events.jsonl (config/clog.py); the session's
# small files are archived to logs/sessions/ at exit; `claude-local-doctor` reads all of it.
#
# Switching models: pick one in the menu at start, type `/model <preset>` mid-session
# (llama-server router mode loads it on demand; the statusline follows Claude's choice),
# or answer (a)nother in the post-exit menu.
#
# Files in the config dir: backend-<name>.sh, picker.py, proxy.py, mcp-websearch.py,
# system_prompt.md, system_prompt_compact.md, statusline.sh, bench/.
# Per-session state lives in run/<pid>/ and is exported as CLAUDE_LOCAL_SESSION_DIR.

set -uo pipefail

CONFIG_DIR="${CLAUDE_LOCAL_CONFIG:-$HOME/.claude-local}"
# Persisted defaults written by bootstrap (e.g. CLAUDE_LOCAL_PORT). Explicit
# environment variables win: the file only sets what is still unset.
[ -r "$CONFIG_DIR/env" ] && . "$CONFIG_DIR/env"
PORT="${CLAUDE_LOCAL_PORT:-1234}"
export CLAUDE_LOCAL_PORT="$PORT"          # statusline and bench read it
BASE_URL="http://localhost:${PORT}"
BACKEND="${CLAUDE_LOCAL_BACKEND:-ollama}"
USE_PROXY="${CLAUDE_LOCAL_PROXY:-1}"
PROXY_PORT="${CLAUDE_LOCAL_PROXY_PORT:-$((PORT + 1))}"
PROMPT_MODE="${CLAUDE_LOCAL_PROMPT:-append}"
MAX_OUTPUT="${CLAUDE_LOCAL_MAX_OUTPUT:-16384}"
TOOLS="${CLAUDE_LOCAL_TOOLS-Bash,Read,Edit,Write,Grep,Glob,Agent,WebFetch,TodoWrite,TaskCreate,TaskList,TaskUpdate,TaskGet,TaskStop,TaskOutput,ProposeGoal,ReportFindings}"
DISALLOWED_TOOLS="${CLAUDE_LOCAL_DISALLOWED_TOOLS-}"
OFFLINE="${CLAUDE_LOCAL_OFFLINE:-0}"
SNAPSHOT="${CLAUDE_LOCAL_SNAPSHOT:-1}"
CHECKPOINT="${CLAUDE_LOCAL_CHECKPOINT:-20}"
IDLE_UNLOAD="${CLAUDE_LOCAL_IDLE_UNLOAD:-1200}"
EXCLUSIVE="${CLAUDE_LOCAL_EXCLUSIVE:-1}"
PERMISSION_MODE="${CLAUDE_LOCAL_PERMISSION_MODE:-acceptEdits}"
AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-local}"

export CLAUDE_CONFIG_DIR="$CONFIG_DIR"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT"
if [ "$OFFLINE" = "1" ]; then
  # Hard network cutoff: everything that is not localhost fails fast. Local
  # server, proxy and MCP servers on localhost are unaffected.
  export HTTPS_PROXY="http://127.0.0.1:9" HTTP_PROXY="http://127.0.0.1:9"
  export https_proxy="$HTTPS_PROXY" http_proxy="$HTTP_PROXY"
  export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1"
fi

say()  { printf '\033[1;34m[local]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[local] error:\033[0m %s\n' "$*" >&2; return 1; }
warn() { printf '\033[1;33m[local] warn:\033[0m %s\n' "$*" >&2; }
LOG_DIR="${CLAUDE_LOCAL_LOG_DIR:-$CONFIG_DIR/logs}"; mkdir -p "$LOG_DIR" 2>/dev/null
export CLAUDE_LOCAL_LOG_DIR="$LOG_DIR"
ev() { # kind level [key=value ...] -> one structured event (config/clog.py) in the session and global logs
  python3 "$CONFIG_DIR/clog.py" "$1" "$2" src=launcher "${@:3}" >/dev/null 2>&1 || true
}

# --- 0. Backend adapter --------------------------------------------------------
BACKEND_FILE="$CONFIG_DIR/backend-${BACKEND}.sh"
[ -r "$BACKEND_FILE" ] || { err "no backend adapter at $BACKEND_FILE"; exit 1; }
# shellcheck source=/dev/null
. "$BACKEND_FILE"

# --- 1. Ensure the server is reachable -----------------------------------------
if ! backend_up; then
  say "Server not responding at ${BASE_URL}; trying to start it..."
  backend_start
  if ! backend_up; then
    err "Server is not reachable at ${BASE_URL}."
    ev server_unreachable error backend="$BACKEND" port="$PORT" hint="unit down or still loading; see backend_start_hint / claude-local-doctor"
    backend_start_hint
    read -r -p "  Press Enter once the server is running to retry, or Ctrl-C to abort: " _
    backend_up || { err "Server still not reachable. Aborting."; ev server_unreachable error backend="$BACKEND" port="$PORT" aborted=1; exit 1; }
  fi
fi
say "Server is up at ${BASE_URL}"

# --- 1b. One server on the GPU pool at a time ---------------------------------
# Ollama and llama-server share the same unified memory; a model left resident on the
# other one is the realistic way to run the pool out. Evict it (llama-server presets get
# their prompt cache saved first, so they come back warm).
if [ "$EXCLUSIVE" = 1 ]; then
  if [ "$BACKEND" = llamaserver ]; then
    OP="http://localhost:${CLAUDE_LOCAL_OLLAMA_PORT:-1234}"
    for m in $(curl -s --max-time 2 "$OP/api/ps" 2>/dev/null | jq -r '[.models[].name] | join(" ")' 2>/dev/null); do
      say "Evicting $m from Ollama (CLAUDE_LOCAL_EXCLUSIVE=0 keeps it)"
      curl -s --max-time 600 "$OP/api/generate" -d "{\"model\":\"$m\",\"prompt\":\"\",\"stream\":false,\"options\":{\"num_predict\":0},\"keep_alive\":0}" >/dev/null 2>&1
    done
  else
    LP="http://localhost:${CLAUDE_LOCAL_LLAMASERVER_PORT:-1244}"
    for m in $(curl -sf --max-time 2 "$LP/models" 2>/dev/null | jq -r '[.data[] | select(.status.value == "loaded") | .id] | join(" ")' 2>/dev/null); do
      say "Dehydrating $m on llama-server (CLAUDE_LOCAL_EXCLUSIVE=0 keeps it)"
      f="claude-local-$(printf '%s' "$m" | tr -c 'A-Za-z0-9._-' '_').bin"
      curl -s --max-time 600 -X POST "$LP/slots/0?action=save" -H 'content-type: application/json' -d "{\"filename\":\"$f\",\"model\":\"$m\"}" >/dev/null 2>&1
      curl -s --max-time 60 -X POST "$LP/models/unload" -H 'content-type: application/json' -d "{\"model\":\"$m\"}" >/dev/null 2>&1
    done
  fi
fi

# --- 2. Per-session state dir (so concurrent sessions never share files) --------
RUN_ROOT="$CONFIG_DIR/run"
mkdir -p "$RUN_ROOT"
archive_dir() { # $1 = run/<pid> dir, $2 = launcher pid: keep its small files as logs/sessions/<start>-<pid>/ (once)
  local d=$1 p=$2 a f
  [ -f "$d/session_start" ] || return 0
  ls -d "$LOG_DIR/sessions/"*"-$p" >/dev/null 2>&1 && return 0
  a="$LOG_DIR/sessions/$(date -d "@$(cat "$d/session_start")" +%Y%m%d-%H%M%S 2>/dev/null || date +%Y%m%d-%H%M%S)-$p"
  mkdir -p "$a" 2>/dev/null || return 0
  for f in session_model context_max proxy_port proxy.log usage.jsonl events.jsonl tools.jsonl mcp.json; do
    [ -f "$d/$f" ] && cp "$d/$f" "$a/" 2>/dev/null
  done
  [ -f "$d/claude-debug.log" ] && tail -c 4000000 "$d/claude-debug.log" > "$a/claude-debug.log" 2>/dev/null
  [ -d "$d/requests" ] && cp -r "$d/requests" "$a/" 2>/dev/null
  ls -1dt "$LOG_DIR"/sessions/*/ 2>/dev/null | tail -n +41 | xargs -r rm -rf   # keep the last 40
}
for d in "$RUN_ROOT"/*/; do            # reap dirs whose launcher is gone; a killed launcher's logs are archived first
  [ -d "$d" ] || continue
  p=$(basename "$d"); d="${d%/}"
  [[ "$p" =~ ^[0-9]+$ ]] && ! kill -0 "$p" 2>/dev/null || continue
  if [ -f "$d/session_start" ] && ! ls -d "$LOG_DIR/sessions/"*"-$p" >/dev/null 2>&1; then
    archive_dir "$d" "$p"
    ev session_reaped warn pid="$p" model="$(cat "$d/session_model" 2>/dev/null)" hint="launcher $p never ran its exit path (killed, or its terminal closed); its files are in $LOG_DIR/sessions"
  fi
  rm -rf "$d"
done
SESSION_DIR="$RUN_ROOT/$$"
mkdir -p "$SESSION_DIR"
export CLAUDE_LOCAL_SESSION_DIR="$SESSION_DIR"
PROXY_PID=""
MODELS_JSON_PATH=""
stop_proxy() { # SIGTERM makes the proxy flush pending checkpoints; wait for that
  [ -n "$PROXY_PID" ] || return 0
  kill "$PROXY_PID" 2>/dev/null; wait "$PROXY_PID" 2>/dev/null; PROXY_PID=""
}
archive_session() { archive_dir "$SESSION_DIR" "$$"; }   # the run dir itself is reaped by the next launch
cleanup() {
  stop_proxy
  archive_session
  rm -f "$MODELS_JSON_PATH"
}
trap cleanup EXIT

# --- 3. Inventory + interactive picker -----------------------------------------
MODELS_JSON_PATH=$(mktemp)
backend_models_json "$MODELS_JSON_PATH"
PICK=$(CLAUDE_LOCAL_MODEL="${CLAUDE_LOCAL_MODEL:-}" MODELS_JSON_PATH="$MODELS_JSON_PATH" \
       LOADED_MODELS="$(backend_loaded_names)" python3 "$CONFIG_DIR/picker.py")
ACTION="${PICK%%|*}"
MODEL="${PICK#*|}"
case "$ACTION" in
  USE|LOAD) : ;;
  *) err "${PICK#ERR:}"; ev picker_failed error backend="$BACKEND" error="${PICK#ERR:}"; exit 1 ;;
esac

# --- 4. Load the model with a spinner + elapsed time -----------------------------
load_with_progress() { # $1 = model
  local m=$1 t0 el pid rc
  local spins=( "◐" "◓" "◑" "◒" )
  t0=$(date +%s)
  backend_load "$m" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    el=$(( $(date +%s) - t0 ))
    printf '\033[1;34m[local]\033[0m loading %s %s %2ds\r' "$m" "${spins[$((el % 4))]}" "$el" >&2
    sleep 0.2
  done
  wait "$pid"; rc=$?
  el=$(( $(date +%s) - t0 ))
  printf '\033[1;34m[local]\033[0m loaded %s      %2ds\n' "$m" "$el" >&2
  echo "$el" >> "$CONFIG_DIR/load_history"
  return $rc
}
if [ "$ACTION" = "LOAD" ]; then
  t_load=$(date +%s)
  load_with_progress "$MODEL" || { err "Failed to load model ${MODEL}."; ev model_load_failed error model="$MODEL" backend="$BACKEND" s=$(( $(date +%s) - t_load )) hint="journalctl --user -u llama-server.service -e; claude-local-doctor checks the GGUF and the INI"; exit 1; }
  ev model_load info model="$MODEL" backend="$BACKEND" s=$(( $(date +%s) - t_load ))
else
  say "Model ${MODEL} is already loaded."
fi
# Mark the model used now, so another session's idle-unload pass leaves it alone.
python3 - "$RUN_ROOT/last_use.json" "$MODEL" <<'LEDGER' 2>/dev/null || true
import fcntl, json, os, sys, time
p, m = sys.argv[1], sys.argv[2]
with open(p + ".lock", "w") as lf:
    fcntl.flock(lf, fcntl.LOCK_EX)
    try: d = json.load(open(p))
    except (OSError, ValueError): d = {}
    d[m] = time.time()
    json.dump(d, open(p + ".tmp", "w")); os.replace(p + ".tmp", p)
LEDGER

# --- 5. Match Claude's context assumptions to the server's real context --------
# Claude Code assumes 200K for unknown models. If the server's context is
# smaller, the prompt would be silently truncated from the front (dropping the
# system prompt and tools) before Claude ever compacts. Prompt + generation must
# fit the window, so autocompact = context - max output - margin. Claude's floor
# is 100K, so the server needs >= 100K + max output + 2K to be safe.
CTX=$(backend_context_length "$MODEL")
CLAUDE_FLAGS=()
if [ -n "${CLAUDE_LOCAL_AUTOCOMPACT:-}" ]; then
  AUTOCOMPACT="$CLAUDE_LOCAL_AUTOCOMPACT"
elif [ -n "$CTX" ]; then
  AUTOCOMPACT=$(( CTX - MAX_OUTPUT - 2048 ))
else
  AUTOCOMPACT=""
fi
if [ -n "$AUTOCOMPACT" ]; then
  if [ "$AUTOCOMPACT" -lt 100000 ] 2>/dev/null; then
    warn "context ${CTX:-?} leaves only ${AUTOCOMPACT} for the prompt after ${MAX_OUTPUT} output tokens; Claude's autocompact floor is 100000, so long sessions may be truncated. Raise the server context (OLLAMA_CONTEXT_LENGTH / LLAMA_ARG_CTX_SIZE) to >= $(( 100000 + MAX_OUTPUT + 2048 )) or lower CLAUDE_LOCAL_MAX_OUTPUT."
    AUTOCOMPACT=100000
  fi
  CLAUDE_FLAGS+=(--autocompact "$AUTOCOMPACT")
fi

# --- 6. System prompt (templated per model) ----------------------------------
render_prompt() { # $1 = template, $2 = output
  sed "s|{{MODEL}}|${MODEL}|g" "$1" > "$2"
}
case "$PROMPT_MODE" in
  append)
    render_prompt "$CONFIG_DIR/system_prompt.md" "$SESSION_DIR/system_prompt.md"
    CLAUDE_FLAGS+=(--append-system-prompt-file "$SESSION_DIR/system_prompt.md") ;;
  replace)
    render_prompt "$CONFIG_DIR/system_prompt_compact.md" "$SESSION_DIR/system_prompt.md"
    CLAUDE_FLAGS+=(--system-prompt-file "$SESSION_DIR/system_prompt.md") ;;
  none) : ;;
  *) warn "unknown CLAUDE_LOCAL_PROMPT=$PROMPT_MODE; using none" ;;
esac
# Keep the rendered system prompt byte-identical across turns and resumes so the
# server's prefix cache survives. (--append-system-prompt turns the snapshot off
# by default, which is exactly the case we need it on for.)
if [ "$SNAPSHOT" = "1" ]; then
  CLAUDE_FLAGS+=(--system-prompt-snapshot on --exclude-dynamic-system-prompt-sections)
fi
[ -n "$TOOLS" ] && CLAUDE_FLAGS+=(--tools "$TOOLS")
[ -n "$DISALLOWED_TOOLS" ] && CLAUDE_FLAGS+=(--disallowedTools "$DISALLOWED_TOOLS")

# --- 6b. Web search as an MCP server ---------------------------------------------
# --tools limits the built-in set only; MCP tools ride along. The built-in WebSearch
# is executed by Anthropic's API and returns nothing against a local server, so the
# model gets a DuckDuckGo tool instead (mcp__websearch__web_search).
WEBSEARCH="${CLAUDE_LOCAL_WEBSEARCH:-1}"
[ "$OFFLINE" = "1" ] && WEBSEARCH=0
if [ "$WEBSEARCH" = "1" ]; then
  printf '{"mcpServers":{"websearch":{"type":"stdio","command":"python3","args":["%s/mcp-websearch.py"]}}}\n' "$CONFIG_DIR" > "$SESSION_DIR/mcp.json"
  CLAUDE_FLAGS+=(--mcp-config "$SESSION_DIR/mcp.json")
fi

# --- 7. Usage proxy (per-turn cache hit / tok/s for the statusline) ------------
CLAUDE_BASE_URL="$BASE_URL"
if [ "$USE_PROXY" = "1" ]; then
  rm -f "$SESSION_DIR/proxy_port"
  PROXY_PORT="$PROXY_PORT" PROXY_PORT_FILE="$SESSION_DIR/proxy_port" UPSTREAM_PORT="$PORT" \
    USAGE_LOG="$SESSION_DIR/usage.jsonl" \
    PROXY_BACKEND="$BACKEND" PROXY_CHECKPOINT_S="$CHECKPOINT" PROXY_IDLE_UNLOAD_S="$IDLE_UNLOAD" PROXY_STATE_DIR="$RUN_ROOT" SLOTS_DIR="$CONFIG_DIR/slots" \
    PROXY_SAMPLING="${CLAUDE_LOCAL_SAMPLING:-}" PROXY_DEBUG="${CLAUDE_LOCAL_PROXY_DEBUG:-}" PROXY_SESSION_MODEL="$MODEL" \
    python3 "$CONFIG_DIR/proxy.py" 2>> "$SESSION_DIR/proxy.log" &
  PROXY_PID=$!
  # The proxy binds its own port (atomic claim) and reports it via the port file.
  for _ in $(seq 1 20); do
    [ -s "$SESSION_DIR/proxy_port" ] && break
    kill -0 "$PROXY_PID" 2>/dev/null || break
    sleep 0.15
  done
  BOUND=$(cat "$SESSION_DIR/proxy_port" 2>/dev/null || true)
  PROBE=$(backend_probe_path 2>/dev/null || echo /api/tags)
  if [ -n "$BOUND" ] && curl -sf --max-time 2 -o /dev/null "http://localhost:${BOUND}${PROBE}"; then
    PROXY_PORT="$BOUND"
    CLAUDE_BASE_URL="http://localhost:${PROXY_PORT}"
  else
    warn "usage proxy failed to start (see $SESSION_DIR/proxy.log); connecting directly."
    ev proxy_start_failed warn log="$SESSION_DIR/proxy.log" hint="without the proxy: no usage rows, no checkpoints, no system-message fold (Qwen3.8 fails), no error log for turns"
    kill "$PROXY_PID" 2>/dev/null; PROXY_PID=""
  fi
fi

# --- 8. Launch Claude Code -----------------------------------------------------
# Export operational state so the model can read its own configuration at runtime.
export CLAUDE_LOCAL_BACKEND="$BACKEND"
export CLAUDE_LOCAL_TOOLS="${TOOLS}"
export CLAUDE_LOCAL_OFFLINE="$OFFLINE"
export CLAUDE_LOCAL_WEBSEARCH="$WEBSEARCH"
export CLAUDE_LOCAL_URLGUARD="${CLAUDE_LOCAL_URLGUARD:-1}"
export CLAUDE_LOCAL_CHECKPOINT="$CHECKPOINT"
export CLAUDE_LOCAL_IDLE_UNLOAD="$IDLE_UNLOAD"
export CLAUDE_LOCAL_EXCLUSIVE="$EXCLUSIVE"
export CLAUDE_LOCAL_SNAPSHOT="$SNAPSHOT"
export CLAUDE_LOCAL_PERMISSION_MODE="$PERMISSION_MODE"
# Every internal model choice stays on the box. Subagents asked for opus/sonnet/haiku, the
# auto-mode classifier, the background classifier and context collapse otherwise request a
# hosted model name the router does not know (2026-09-08: the auto-mode classifier asked for
# claude-sonnet-5, got HTTP 400, then ran its 35K-token prompt on the local slot as a fallback).
# Six variables: CLAUDE_CODE_SUBAGENT_MODEL stays unset so subagents follow a mid-session
# /model switch (Claude Code gives a subagent the parent's current model unless it is set).
# Any claude-* name that still reaches the proxy is rewritten to the session's current model
# there (model_rewritten event); the proxy learns the launch model through PROXY_SESSION_MODEL.
for v in ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL \
         CLAUDE_CODE_AUTO_MODE_MODEL CLAUDE_CODE_BG_CLASSIFIER_MODEL CLAUDE_CONTEXT_COLLAPSE_MODEL; do
  [ -n "${!v:-}" ] || export "$v=$MODEL"
done
# Permission mode: the deterministic guard in hook-audit.py is the gate in every mode; auto
# mode's classifier would cost a ~35K-token prompt per evaluated tool call on the single slot.
case " $* " in
  *" --permission-mode"*|*" --dangerously-skip-permissions "*) : ;;    # the caller's choice wins
  *) [ "$PERMISSION_MODE" = auto ] && warn "CLAUDE_LOCAL_PERMISSION_MODE=auto: settings.json sets permissions.disableAutoMode, so Claude Code ignores this and starts without auto mode (its classifier would cost a ~35K-token prompt per tool call on the slot)"
     CLAUDE_FLAGS+=(--permission-mode "$PERMISSION_MODE") ;;
esac
export ANTHROPIC_BASE_URL="$CLAUDE_BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$AUTH_TOKEN"
# settings.json's env block overrides the process environment, and CLI
# --settings overrides settings.json: pass the URL there so the proxy is honoured.
CLAUDE_FLAGS+=(--settings "{\"env\":{\"ANTHROPIC_BASE_URL\":\"${CLAUDE_BASE_URL}\",\"ANTHROPIC_AUTH_TOKEN\":\"${AUTH_TOKEN}\"}}")
# Disable the changing attribution header so the server prefix cache is reused
# between turns. Local backend only.
export CLAUDE_CODE_ATTRIBUTION_HEADER="0"
# Claude Code 2.1.265 otherwise appends a role:system "<total_tokens>N tokens left" message with a
# new number on every request; folded into the system prompt it re-prefilled tools + conversation
# each turn (0% cache, 2026-09-08). The proxy also strips it (strip_volatile) if it ever arrives.
export CLAUDE_CODE_TOTAL_TOKENS_REMINDER="${CLAUDE_CODE_TOTAL_TOKENS_REMINDER:-off}"
# Claude Code's own debug log: API attempts and errors, MCP and hook traffic. Written to a
# file only; the TUI is unchanged. Archived with the session.
if [ "${CLAUDE_LOCAL_CLAUDE_DEBUG:-1}" = 1 ]; then CLAUDE_FLAGS+=(--debug-file "$SESSION_DIR/claude-debug.log"); fi

date +%s > "$SESSION_DIR/session_start"
printf '%s' "$MODEL" > "$SESSION_DIR/session_model"
printf '%s' "${AUTOCOMPACT:-}" > "$SESSION_DIR/context_max"   # statusline gauge ceiling

say "Starting Claude Code: model=${MODEL} ctx=${CTX:-?} autocompact=${AUTOCOMPACT:-auto} max_output=${MAX_OUTPUT} prompt=${PROMPT_MODE} mode=${PERMISSION_MODE} offline=${OFFLINE} websearch=${WEBSEARCH} checkpoint=${CHECKPOINT}s idle_unload=${IDLE_UNLOAD}s via ${CLAUDE_BASE_URL} (config: ${CONFIG_DIR})"
ev session_start info model="$MODEL" backend="$BACKEND" port="$PORT" proxy_port="${PROXY_PORT}" proxy="${PROXY_PID:+1}${PROXY_PID:-0}" ctx="${CTX:-}" autocompact="${AUTOCOMPACT:-}" max_output="$MAX_OUTPUT" permission_mode="$PERMISSION_MODE" tools="$TOOLS" websearch="$WEBSEARCH" offline="$OFFLINE" checkpoint="$CHECKPOINT" idle_unload="$IDLE_UNLOAD" cwd="$PWD"
# Claude Code reads Ctrl-C itself in raw terminal mode; ignoring INT here only
# keeps this wrapper alive so the post-exit menu still runs.
trap '' INT
claude --model "$MODEL" "${CLAUDE_FLAGS[@]}" "$@"
CLAUDE_EXIT=$?
trap - INT
say "Claude Code exited (code ${CLAUDE_EXIT})."
count() { local n; n=$(grep -c -- "$1" "$2" 2>/dev/null | head -1); echo "${n:-0}"; }   # grep -c exits 1 on zero matches
n_turns=$(count '"ts"' "$SESSION_DIR/usage.jsonl")
n_errors=$(count '"level": "error"' "$SESSION_DIR/events.jsonl")
n_denied=$(count '"denied"' "$SESSION_DIR/tools.jsonl")
ev claude_exit "$([ "$CLAUDE_EXIT" = 0 ] && echo info || echo warn)" code="$CLAUDE_EXIT" duration_s=$(( $(date +%s) - $(cat "$SESSION_DIR/session_start") )) model="$MODEL" turns="$n_turns" errors="$n_errors" denied="$n_denied"
if [ "$n_errors" != 0 ] || [ "$CLAUDE_EXIT" != 0 ]; then
  warn "${n_errors} error event(s) this session; claude-local-doctor summarises them (archive: $LOG_DIR/sessions/)"
fi
# Save the prompt cache now (auto-dehydrate): the proxy flushes on SIGTERM; without a
# proxy the adapter saves the launch model's slot directly.
if [ -n "$PROXY_PID" ]; then stop_proxy
elif [ "$CHECKPOINT" != 0 ] && declare -F backend_checkpoint >/dev/null; then backend_checkpoint "$MODEL"; fi

# --- 9. Post-exit model action: unload / leave / load another ------------------
still_loaded=$(backend_loaded_names)
if [ -n "$still_loaded" ]; then
  printf '\033[1;36mmodels in memory:\033[0m %s  (u)nload  load (a)nother  [Enter=leave]  ' "$still_loaded" >&2
  read -r ans
  case "${ans:-}" in
    u|U|unload)
      for m in ${still_loaded//,/ }; do say "Unloading ${m}..."; backend_unload "$m"; done
      remaining=$(backend_loaded_names)
      if declare -F backend_unload_keeps_model >/dev/null && backend_unload_keeps_model; then say "Prompt cache saved; server left running (CLAUDE_LOCAL_LLAMA_STOP_ON_UNLOAD=1 to stop it)."
      elif [ -n "$remaining" ]; then warn "Still loaded: ${remaining}"; else say "Memory freed."; fi ;;
    a|A|another)
      PICK2=$(CLAUDE_LOCAL_MODEL="" MODELS_JSON_PATH="$MODELS_JSON_PATH" \
              LOADED_MODELS="$(backend_loaded_names)" python3 "$CONFIG_DIR/picker.py")
      M2="${PICK2#*|}"
      case "${PICK2%%|*}" in
        USE|LOAD) load_with_progress "$M2" && say "Now loaded: $(backend_loaded_names)" ;;
        *) err "${PICK2#ERR:}" ;;
      esac ;;
    *) say "Leaving ${still_loaded} loaded." ;;
  esac
else
  say "No model is loaded."
fi

exit "${CLAUDE_EXIT:-0}"
