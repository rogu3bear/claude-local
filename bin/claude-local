#!/usr/bin/env bash
# claude-local: launch Claude Code exclusively against a local model server,
# using a fully isolated config directory so your normal ~/.claude setup is
# never read or written.
#
# Flow: check server -> pick a model (with load state) -> load it (timed) ->
# start a usage proxy -> start claude pointed at it, with prefix-cache-friendly
# flags and an autocompact window matched to the server's real context ->
# after close, offer to unload / leave / load a different model.
#
# Env overrides:
#   CLAUDE_LOCAL_MODEL        model name to use directly, skipping the menu
#   CLAUDE_LOCAL_PORT         server port (default 1234)
#   CLAUDE_LOCAL_CONFIG       isolated config dir (default ~/.claude-local)
#   CLAUDE_LOCAL_BACKEND      backend adapter name: ollama (default) | llamaserver
#                             (the env file maps each backend to its port: 1234 / 1244)
#   CLAUDE_LOCAL_PROXY        1 = route through the usage proxy (default 1), 0 = direct
#   CLAUDE_LOCAL_PROXY_PORT   first proxy port to try (default PORT+1; next free one is used)
#   CLAUDE_LOCAL_MAX_OUTPUT   max output tokens per turn (default 8192; Claude's own default is 32000)
#   CLAUDE_LOCAL_AUTOCOMPACT  autocompact window in tokens
#                             (default: server context - max output - 2048, floor 100000)
#   CLAUDE_LOCAL_OFFLINE      1 = block all non-localhost network from Claude via a dead
#                             HTTPS_PROXY (default 1); 0 = allow internet (MCP servers etc.)
#   CLAUDE_LOCAL_PROMPT       append | replace | none  (default append)
#                             append  = built-in prompt + system_prompt.md
#                             replace = system_prompt_compact.md instead of the built-in prompt
#   CLAUDE_LOCAL_SNAPSHOT     1 = --system-prompt-snapshot on + exclude dynamic sections (default 1)
#   CLAUDE_LOCAL_DISALLOWED_TOOLS  comma list passed as --disallowedTools. Default prunes the
#                             tools a small local model only wastes turns on (measured: through
#                             llama-server it made 30 ReportFindings + 20 TaskList calls per 27
#                             tasks, plus subagents): Agent,ReportFindings,TaskCreate,TaskUpdate,TaskList,TaskGet,WebFetch,WebSearch,NotebookEdit.
#                             Set to "" to allow everything.
#   CLAUDE_LOCAL_SAMPLING     JSON sampling override applied by the proxy to every request,
#                             e.g. '{"temperature":0.7,"top_p":0.8,"top_k":20}' (default: none)
#   CLAUDE_LOCAL_PROXY_DEBUG  1 = proxy also logs request params/tool count/system size
#
# Files in the config dir: backend-<name>.sh, picker.py, proxy.py,
# system_prompt.md, system_prompt_compact.md, statusline.sh, bench/.
# Per-session state lives in run/<pid>/ and is exported as CLAUDE_LOCAL_SESSION_DIR.

set -uo pipefail

CONFIG_DIR="${CLAUDE_LOCAL_CONFIG:-$HOME/.claude-local}"
# Persisted defaults written by bootstrap (e.g. CLAUDE_LOCAL_PORT). Explicit
# environment variables win: the file only sets what is still unset.
[ -r "$CONFIG_DIR/env" ] && . "$CONFIG_DIR/env"
PORT="${CLAUDE_LOCAL_PORT:-1234}"
export CLAUDE_LOCAL_PORT="$PORT"          # statusline and bench read it
BASE_URL="http://localhost:${PORT}"
BACKEND="${CLAUDE_LOCAL_BACKEND:-ollama}"
USE_PROXY="${CLAUDE_LOCAL_PROXY:-1}"
PROXY_PORT="${CLAUDE_LOCAL_PROXY_PORT:-$((PORT + 1))}"
PROMPT_MODE="${CLAUDE_LOCAL_PROMPT:-append}"
MAX_OUTPUT="${CLAUDE_LOCAL_MAX_OUTPUT:-8192}"
DISALLOWED_TOOLS="${CLAUDE_LOCAL_DISALLOWED_TOOLS-Agent,ReportFindings,TaskCreate,TaskUpdate,TaskList,TaskGet,WebFetch,WebSearch,NotebookEdit}"
OFFLINE="${CLAUDE_LOCAL_OFFLINE:-1}"
SNAPSHOT="${CLAUDE_LOCAL_SNAPSHOT:-1}"
AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-local}"

export CLAUDE_CONFIG_DIR="$CONFIG_DIR"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT"
if [ "$OFFLINE" = "1" ]; then
  # Hard network cutoff: everything that is not localhost fails fast. Local
  # server, proxy and MCP servers on localhost are unaffected.
  export HTTPS_PROXY="http://127.0.0.1:9" HTTP_PROXY="http://127.0.0.1:9"
  export https_proxy="$HTTPS_PROXY" http_proxy="$HTTP_PROXY"
  export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1"
fi

say()  { printf '\033[1;34m[local]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[local] error:\033[0m %s\n' "$*" >&2; return 1; }
warn() { printf '\033[1;33m[local] warn:\033[0m %s\n' "$*" >&2; }

# --- 0. Backend adapter --------------------------------------------------------
BACKEND_FILE="$CONFIG_DIR/backend-${BACKEND}.sh"
[ -r "$BACKEND_FILE" ] || { err "no backend adapter at $BACKEND_FILE"; exit 1; }
# shellcheck source=/dev/null
. "$BACKEND_FILE"

# --- 1. Ensure the server is reachable -----------------------------------------
if ! backend_up; then
  say "Server not responding at ${BASE_URL}; trying to start it..."
  backend_start
  if ! backend_up; then
    err "Server is not reachable at ${BASE_URL}."
    backend_start_hint
    read -r -p "  Press Enter once the server is running to retry, or Ctrl-C to abort: " _
    backend_up || { err "Server still not reachable. Aborting."; exit 1; }
  fi
fi
say "Server is up at ${BASE_URL}"

# --- 2. Per-session state dir (so concurrent sessions never share files) --------
RUN_ROOT="$CONFIG_DIR/run"
mkdir -p "$RUN_ROOT"
for d in "$RUN_ROOT"/*/; do            # reap dirs whose launcher is gone
  [ -d "$d" ] || continue
  p=$(basename "$d")
  [[ "$p" =~ ^[0-9]+$ ]] && ! kill -0 "$p" 2>/dev/null && rm -rf "$d"
done
SESSION_DIR="$RUN_ROOT/$$"
mkdir -p "$SESSION_DIR"
export CLAUDE_LOCAL_SESSION_DIR="$SESSION_DIR"
PROXY_PID=""
MODELS_JSON_PATH=""
cleanup() {
  [ -n "$PROXY_PID" ] && kill "$PROXY_PID" 2>/dev/null
  rm -f "$MODELS_JSON_PATH"
}
trap cleanup EXIT

# --- 3. Inventory + interactive picker -----------------------------------------
MODELS_JSON_PATH=$(mktemp)
backend_models_json "$MODELS_JSON_PATH"
PICK=$(CLAUDE_LOCAL_MODEL="${CLAUDE_LOCAL_MODEL:-}" MODELS_JSON_PATH="$MODELS_JSON_PATH" \
       LOADED_MODELS="$(backend_loaded_names)" python3 "$CONFIG_DIR/picker.py")
ACTION="${PICK%%|*}"
MODEL="${PICK#*|}"
case "$ACTION" in
  USE|LOAD) : ;;
  *) err "${PICK#ERR:}"; exit 1 ;;
esac

# --- 4. Load the model with a spinner + elapsed time -----------------------------
load_with_progress() { # $1 = model
  local m=$1 t0 el pid rc
  local spins=( "◐" "◓" "◑" "◒" )
  t0=$(date +%s)
  backend_load "$m" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    el=$(( $(date +%s) - t0 ))
    printf '\033[1;34m[local]\033[0m loading %s %s %2ds\r' "$m" "${spins[$((el % 4))]}" "$el" >&2
    sleep 0.2
  done
  wait "$pid"; rc=$?
  el=$(( $(date +%s) - t0 ))
  printf '\033[1;34m[local]\033[0m loaded %s      %2ds\n' "$m" "$el" >&2
  echo "$el" >> "$CONFIG_DIR/load_history"
  return $rc
}
if [ "$ACTION" = "LOAD" ]; then
  load_with_progress "$MODEL" || { err "Failed to load model ${MODEL}."; exit 1; }
else
  say "Model ${MODEL} is already loaded."
fi

# --- 5. Match Claude's context assumptions to the server's real context --------
# Claude Code assumes 200K for unknown models. If the server's context is
# smaller, the prompt would be silently truncated from the front (dropping the
# system prompt and tools) before Claude ever compacts. Prompt + generation must
# fit the window, so autocompact = context - max output - margin. Claude's floor
# is 100K, so the server needs >= 100K + max output + 2K to be safe.
CTX=$(backend_context_length "$MODEL")
CLAUDE_FLAGS=()
if [ -n "${CLAUDE_LOCAL_AUTOCOMPACT:-}" ]; then
  AUTOCOMPACT="$CLAUDE_LOCAL_AUTOCOMPACT"
elif [ -n "$CTX" ]; then
  AUTOCOMPACT=$(( CTX - MAX_OUTPUT - 2048 ))
else
  AUTOCOMPACT=""
fi
if [ -n "$AUTOCOMPACT" ]; then
  if [ "$AUTOCOMPACT" -lt 100000 ] 2>/dev/null; then
    warn "context ${CTX:-?} leaves only ${AUTOCOMPACT} for the prompt after ${MAX_OUTPUT} output tokens; Claude's autocompact floor is 100000, so long sessions may be truncated. Raise the server context (OLLAMA_CONTEXT_LENGTH / LLAMA_ARG_CTX_SIZE) to >= $(( 100000 + MAX_OUTPUT + 2048 )) or lower CLAUDE_LOCAL_MAX_OUTPUT."
    AUTOCOMPACT=100000
  fi
  CLAUDE_FLAGS+=(--autocompact "$AUTOCOMPACT")
fi

# --- 6. System prompt (templated per model) ----------------------------------
render_prompt() { # $1 = template, $2 = output
  sed "s|{{MODEL}}|${MODEL}|g" "$1" > "$2"
}
case "$PROMPT_MODE" in
  append)
    render_prompt "$CONFIG_DIR/system_prompt.md" "$SESSION_DIR/system_prompt.md"
    CLAUDE_FLAGS+=(--append-system-prompt-file "$SESSION_DIR/system_prompt.md") ;;
  replace)
    render_prompt "$CONFIG_DIR/system_prompt_compact.md" "$SESSION_DIR/system_prompt.md"
    CLAUDE_FLAGS+=(--system-prompt-file "$SESSION_DIR/system_prompt.md") ;;
  none) : ;;
  *) warn "unknown CLAUDE_LOCAL_PROMPT=$PROMPT_MODE; using none" ;;
esac
# Keep the rendered system prompt byte-identical across turns and resumes so the
# server's prefix cache survives. (--append-system-prompt turns the snapshot off
# by default, which is exactly the case we need it on for.)
if [ "$SNAPSHOT" = "1" ]; then
  CLAUDE_FLAGS+=(--system-prompt-snapshot on --exclude-dynamic-system-prompt-sections)
fi
[ -n "$DISALLOWED_TOOLS" ] && CLAUDE_FLAGS+=(--disallowedTools "$DISALLOWED_TOOLS")

# --- 7. Usage proxy (per-turn cache hit / tok/s for the statusline) ------------
CLAUDE_BASE_URL="$BASE_URL"
if [ "$USE_PROXY" = "1" ]; then
  rm -f "$SESSION_DIR/proxy_port"
  PROXY_PORT="$PROXY_PORT" PROXY_PORT_FILE="$SESSION_DIR/proxy_port" UPSTREAM_PORT="$PORT" \
    USAGE_LOG="$SESSION_DIR/usage.jsonl" \
    PROXY_SAMPLING="${CLAUDE_LOCAL_SAMPLING:-}" PROXY_DEBUG="${CLAUDE_LOCAL_PROXY_DEBUG:-}" \
    python3 "$CONFIG_DIR/proxy.py" 2>> "$SESSION_DIR/proxy.log" &
  PROXY_PID=$!
  # The proxy binds its own port (atomic claim) and reports it via the port file.
  for _ in $(seq 1 20); do
    [ -s "$SESSION_DIR/proxy_port" ] && break
    kill -0 "$PROXY_PID" 2>/dev/null || break
    sleep 0.15
  done
  BOUND=$(cat "$SESSION_DIR/proxy_port" 2>/dev/null || true)
  PROBE=$(backend_probe_path 2>/dev/null || echo /api/tags)
  if [ -n "$BOUND" ] && curl -sf --max-time 2 -o /dev/null "http://localhost:${BOUND}${PROBE}"; then
    PROXY_PORT="$BOUND"
    CLAUDE_BASE_URL="http://localhost:${PROXY_PORT}"
  else
    warn "usage proxy failed to start (see $SESSION_DIR/proxy.log); connecting directly."
    kill "$PROXY_PID" 2>/dev/null; PROXY_PID=""
  fi
fi

# --- 8. Launch Claude Code -----------------------------------------------------
export ANTHROPIC_BASE_URL="$CLAUDE_BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$AUTH_TOKEN"
# settings.json's env block overrides the process environment, and CLI
# --settings overrides settings.json: pass the URL there so the proxy is honoured.
CLAUDE_FLAGS+=(--settings "{\"env\":{\"ANTHROPIC_BASE_URL\":\"${CLAUDE_BASE_URL}\",\"ANTHROPIC_AUTH_TOKEN\":\"${AUTH_TOKEN}\"}}")
# Disable the changing attribution header so the server prefix cache is reused
# between turns. Local backend only.
export CLAUDE_CODE_ATTRIBUTION_HEADER="0"

date +%s > "$SESSION_DIR/session_start"
printf '%s' "$MODEL" > "$SESSION_DIR/session_model"
printf '%s' "${AUTOCOMPACT:-}" > "$SESSION_DIR/context_max"   # statusline gauge ceiling

say "Starting Claude Code: model=${MODEL} ctx=${CTX:-?} autocompact=${AUTOCOMPACT:-auto} max_output=${MAX_OUTPUT} prompt=${PROMPT_MODE} offline=${OFFLINE} via ${CLAUDE_BASE_URL} (config: ${CONFIG_DIR})"
# Claude Code reads Ctrl-C itself in raw terminal mode; ignoring INT here only
# keeps this wrapper alive so the post-exit menu still runs.
trap '' INT
claude --model "$MODEL" "${CLAUDE_FLAGS[@]}" "$@"
CLAUDE_EXIT=$?
trap - INT
say "Claude Code exited (code ${CLAUDE_EXIT})."

# --- 9. Post-exit model action: unload / leave / load another ------------------
still_loaded=$(backend_loaded_names)
if [ -n "$still_loaded" ]; then
  printf '\033[1;36mmodels in memory:\033[0m %s  (u)nload  load (a)nother  [Enter=leave]  ' "$still_loaded" >&2
  read -r ans
  case "${ans:-}" in
    u|U|unload)
      for m in ${still_loaded//,/ }; do say "Unloading ${m}..."; backend_unload "$m"; done
      remaining=$(backend_loaded_names)
      if declare -F backend_unload_keeps_model >/dev/null && backend_unload_keeps_model; then say "Prompt cache saved; server left running (CLAUDE_LOCAL_LLAMA_STOP_ON_UNLOAD=1 to stop it)."
      elif [ -n "$remaining" ]; then warn "Still loaded: ${remaining}"; else say "Memory freed."; fi ;;
    a|A|another)
      PICK2=$(CLAUDE_LOCAL_MODEL="" MODELS_JSON_PATH="$MODELS_JSON_PATH" \
              LOADED_MODELS="$(backend_loaded_names)" python3 "$CONFIG_DIR/picker.py")
      M2="${PICK2#*|}"
      case "${PICK2%%|*}" in
        USE|LOAD) load_with_progress "$M2" && say "Now loaded: $(backend_loaded_names)" ;;
        *) err "${PICK2#ERR:}" ;;
      esac ;;
    *) say "Leaving ${still_loaded} loaded." ;;
  esac
else
  say "No model is loaded."
fi

exit "${CLAUDE_EXIT:-0}"
