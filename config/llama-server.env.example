# claude-local llama-server.service configuration.
# Edit, then:  systemctl --user restart llama-server.service
#
# 1. Device = which build runs. ROCm0 -> $LLAMA_CPP_DIR/build-hip, Vulkan0 -> build-vulkan.
LLAMA_DEVICE=ROCm0
LLAMA_CPP_DIR=__HOME__/ai/llama.cpp
# 2. Model. The alias is the name Claude, the picker and the smoke test use;
#    llama-server ignores the request's model field in single-model mode.
LLAMA_ARG_MODEL=__MODEL_GGUF__
LLAMA_ARG_ALIAS=qwen3-coder:30b
# 3. Speculative decoding. OFF by default: measured 2026-09-05 on gfx1151 (Vulkan) it
#    LOWERS decode (draft-simple 25 tok/s, ngram-cache 41 vs 72 plain) because batch
#    verification on the iGPU costs more than the tokens it saves. Uncomment to try
#    again on other hardware; draft-simple needs the draft model below, ngram-* need none.
#LLAMA_ARG_SPEC_TYPE=draft-simple
LLAMA_ARG_SPEC_DRAFT_MODEL=__HOME__/.claude-local/models/Qwen3-0.6B-Q8_0.gguf
LLAMA_ARG_SPEC_DRAFT_N_MAX=8
LLAMA_ARG_SPEC_DRAFT_N_MIN=0
LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_K=q8_0
LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_V=q8_0
# 4. Extra flags appended verbatim. Default pins Qwen's recommended sampling
#    (the same values Ollama's Modelfile uses), since Claude sends none.
LLAMA_EXTRA_ARGS=--temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --repeat-penalty 1.05
# Optional: LLAMA_LD_LIBRARY_PATH=/opt/rocm/lib:...   (only if ldd reports missing libs after a ROCm move)
