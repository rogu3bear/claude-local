# claude-local llama-server.service configuration.
# Edit, then:  systemctl --user restart llama-server.service
#
# 1. Device = which build runs. Vulkan0 -> $LLAMA_CPP_DIR/build-vulkan, ROCm0 -> build-hip.
#    Measured on gfx1151: 2026-09-05 Vulkan decoded Qwen3-Coder faster and ROCm prefilled
#    faster; 2026-09-07 ROCm prefills Qwen3.8-27B 1.6x and Qwen3.6-35B 1.3x faster than Vulkan
#    at equal decode (README model table). bootstrap --gpu picks; ROCm0 is what this host runs.
LLAMA_DEVICE=Vulkan0
LLAMA_CPP_DIR=__HOME__/ai/llama.cpp
# 2. Models. Router mode: every section of the INI is a selectable model (alias = section
#    name); the launcher loads on demand, up to two resident (LLAMA_ARG_MODELS_MAX in
#    the drop-in). Per-model options (sampling, reasoning, speculation) live in the INI.
#    systemd does not expand $HOME here: the path must be absolute.
LLAMA_ARG_MODELS_PRESET=__HOME__/.claude-local/llama-models.ini
#    Single-model mode instead: comment the line above and set these two.
#LLAMA_ARG_MODEL=__MODEL_GGUF__
#LLAMA_ARG_ALIAS=qwen3-coder:30b
# 3. Extra CLI flags appended verbatim, inherited by every model instance and overriding
#    the INI (CLI beats preset), so keep sampling out of here in router mode.
LLAMA_EXTRA_ARGS=
# Optional: LLAMA_LD_LIBRARY_PATH=/opt/rocm/lib:...   (only if ldd reports missing libs after a ROCm move)
