[Unit]
Description=Ollama local LLM server (user-local install, claude-local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__HOME__/.local/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:__PORT__
Environment=HOME=__HOME__
Environment=OLLAMA_FLASH_ATTENTION=1
# AMD iGPU (Strix Halo class) profile: Vulkan via RADV, ROCm disabled.
# For NVIDIA or CPU-only, delete the four lines below before enabling.
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_VULKAN=1
Environment=HIP_VISIBLE_DEVICES=-1
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
Environment=AMD_VULKAN_ICD=RADV
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
