[Unit]
Description=Ollama local LLM server (user-local ROCm install)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/mln-dev/.local/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:1234
Environment=HOME=/home/mln-dev
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_VULKAN=1
Environment=HIP_VISIBLE_DEVICES=-1
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
Environment=AMD_VULKAN_ICD=RADV
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
